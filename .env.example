# Garmin Account Credentials
GARMIN_EMAIL=your_garmin_account@email.com
GARMIN_PASSWORD=your_secure_password

# Webhook Authorization (Bearer Token used by clients like openScale)
API_BEARER_TOKEN=generate_a_long_random_string_for_openscale_header

# Dashboard UI Authorization (Basic Authentication)
API_BASIC_AUTH_USERNAME=admin
API_BASIC_AUTH_PASSWORD=generate_a_secure_dashboard_password

# Optional: Set to true to persist weight upload history and validation error logs to disk.
# If false, logs are only outputted to container stdout (accessed via `docker logs`).
PERSIST_LOGS=false

# Optional: Set to true to accept and log webhook payloads without uploading to Garmin.
# Use this when integrating a new client (e.g. openScale+) to verify payloads locally.
DRY_RUN=false

# --- Shared Garmin token store ---
# Garmin issues a NEW refresh token on every refresh and invalidates the old
# one, so the account has exactly one valid refresh token at any moment. Every
# service using this account (hevy2garmin-lite, etc.) must therefore read and
# write the SAME store, or whichever refreshes second gets locked out.
#
#   file      (default) $DATA_DIR/.garminconnect/garmin_tokens.json — the format
#             the other services already read. Writes are atomic and guarded by
#             a lock file in the same directory. Keep this unless you are moving
#             every service at once.
#   sqlite    $DATA_DIR/garmin_tokens.db. Real write locking via BEGIN IMMEDIATE.
#             Same host only — SQLite locking is unreliable over NFS/SMB.
#   postgres  Requires TOKEN_DB_URL. The only option when services run on
#             different machines.
#
# WARNING: changing this on one service only will stop it sharing tokens with
# the others, which is worse than leaving it alone. Migrate the fleet together.
TOKEN_STORE=file

# Only used when TOKEN_STORE=postgres. For Neon, either endpoint works — the
# store takes a transaction-scoped advisory lock, which is safe behind the
# pooled (PgBouncer transaction-mode) endpoint.
# TOKEN_DB_URL=postgresql://user:password@host/dbname?sslmode=require
